# Imagen publicada por GitHub Actions. Puedes fijar una versión como :1.0.0.
ACEBRIDGE_IMAGE=ghcr.io/anubisreal/acebridge:latest
ACEBRIDGE_PORT=5023
ACEBRIDGE_VOLUME=acebridge_data
TZ=Europe/Madrid

# Actívalo solo si alguna lista M3U/JSON se descarga desde tu propia LAN.
ACEBRIDGE_ALLOW_PRIVATE_SOURCES=false
