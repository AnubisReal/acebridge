[Unit]
Description=AceBridge - canales AceStream para Jellyfin
Documentation=https://github.com/anubisreal/acebridge
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/acebridge
Environment=ACEBRIDGE_LISTEN_ADDR=:8080
Environment=ACEBRIDGE_DATA_DIR=/var/lib/acebridge
Environment=ACEBRIDGE_ALLOW_PRIVATE_SOURCES=false
EnvironmentFile=-/etc/default/acebridge
DynamicUser=yes
StateDirectory=acebridge
StateDirectoryMode=0750
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
